# Required for Maya (the Storefront Concierge agent) to respond.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used by Maya. Defaults to claude-sonnet-4-6 if unset.
MAYA_MODEL=claude-sonnet-4-6

# Optional: set to "true" to allow Maya to run without an API key (returns canned demo replies).
# Useful for sales demos when you don't want to spend tokens.
MAYA_DEMO_MODE=false
