# Required for the Red Teaming Partner to actually call Claude.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model the Partner uses. Defaults to claude-sonnet-4-6.
AGENTS_MODEL=claude-sonnet-4-6

# Optional: set to "true" to force the Partner into demo mode (no API calls).
# If ANTHROPIC_API_KEY is unset the system enters demo mode automatically —
# the fallback still uses the real method, so it stays genuinely useful.
AGENTS_DEMO_MODE=false

# ── Nia's voice ──────────────────────────────────────────────────────────────
# Speech-to-text (talking to Nia) and text-to-speech both work in the browser
# with no key. For the consistent, chosen Black female voice, set an ElevenLabs
# key and a voice ID. Without these, Nia speaks with the best browser voice.
# Get a key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Pick a voice from the ElevenLabs Voice Library and paste its ID here.
# Defaults to an ElevenLabs stock female voice if unset.
ELEVENLABS_VOICE_ID=
# Optional model override. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
