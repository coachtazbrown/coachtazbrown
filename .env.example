# ── SEO ───────────────────────────────────────────────────────────────────────
# Canonical origin for this deployment. Drives canonical URLs, the sitemap,
# robots.txt, and Open Graph URLs — so one codebase serves correct SEO for any
# domain. Set it per Vercel project (e.g. https://tazbrownstrategies.com).
# Unset = https://galacticstudio.app
NEXT_PUBLIC_SITE_URL=

# ── Galactic Studio by Taz ────────────────────────────────────────────────────
# Required for the Studio to run LIVE: research the topic with web search,
# ground the script with RAG, and fact-check every claim with citations.
# Without it, the Studio runs its honest offline engine — a full, usable
# production from the curated corpus that flags every claim needing live
# verification (it never fakes a source).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model the Studio (and the Partner) uses. Defaults to claude-sonnet-4-6.
AGENTS_MODEL=claude-sonnet-4-6

# Optional: set to "true" to force offline/demo mode (no API calls), even with
# a key present. Useful for deterministic demos.
AGENTS_DEMO_MODE=false

# ── Nia's voice ──────────────────────────────────────────────────────────────
# Speech-to-text (talking to Nia) and text-to-speech both work in the browser
# with no key. For the consistent, chosen Black female voice, set an ElevenLabs
# key and a voice ID. Without these, Nia speaks with the best browser voice.
# Get a key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Optional override. Unset = the pinned default (CMlaXsNkOUgEvTGpIezg), the
# ElevenLabs voice selected for Nia. That voice must be added to the account
# above for it to resolve. Paste a different voice ID here to override it.
ELEVENLABS_VOICE_ID=
# Optional model override. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Cross-device library (Supabase) ───────────────────────────────────────────
# The studio saves every production to a local per-device library automatically.
# Cross-device sync uses a Supabase project + a secret "sync key" (capability
# model — no login). A working project is baked in as the default, so sync works
# out of the box. To use your OWN Supabase project, set these (publishable/anon
# key is safe to expose; the table is locked behind key-scoped RPCs):
SUPABASE_URL=
SUPABASE_ANON_KEY=
