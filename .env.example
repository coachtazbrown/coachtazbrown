# Required for Maya, Echo, Sage, and Pip to actually call Claude.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used by every agent. Defaults to claude-sonnet-4-6.
AGENTS_MODEL=claude-sonnet-4-6

# Optional: set to "true" to force every agent into demo mode (canned replies).
# Useful for sales demos when you don't want to spend tokens. If
# ANTHROPIC_API_KEY is unset the system enters demo mode automatically.
AGENTS_DEMO_MODE=false
